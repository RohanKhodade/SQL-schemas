WITH RECURSIVE ph AS (
    SELECT page_id, page_name, url_slug, parent_page_id,
           0 AS level_no,
           page_name AS navigation_path
    FROM pages
    WHERE parent_page_id IS NULL

    UNION ALL

    SELECT p.page_id, p.page_name, p.url_slug, p.parent_page_id,
           ph.level_no + 1,
           CONCAT(ph.navigation_path, ' → ', p.page_name)
    FROM pages p
    JOIN ph ON p.parent_page_id = ph.page_id
)
SELECT ph.page_id, ph.page_name, ph.url_slug, ph.level_no,
       ph.navigation_path, o.owner_name, o.role_title
FROM ph
LEFT JOIN owners o ON ph.page_id = o.page_id
ORDER BY ph.navigation_path;
